# syntax=docker/dockerfile:1
# Build inputs are pinned in containers/tutorial/build-inputs.lock. This image
# is an interactive, disposable local-recovery tutorial, not a distribution.
ARG BUILDKIT_SBOM_SCAN_CONTEXT=true

FROM docker.io/ocaml/opam:debian-12-ocaml-5.5@sha256:b2b7ff41302eae75c20df6f052513d0a13fb440c43a681f632062f056d01421a AS build

USER root
RUN apt-get update \
 && apt-get install --no-install-recommends --yes build-essential libsecret-1-dev libzstd-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*

USER opam
WORKDIR /home/opam/yeokcham
COPY --chown=opam:opam . .
RUN opam install --deps-only --locked --yes ./yeokcham.opam \
 && opam exec -- dune build bin/yeokcham_v1.exe \
 && install -D -m 0755 _build/default/bin/yeokcham_v1.exe /home/opam/out/yeokcham

FROM docker.io/library/debian:12-slim@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867

RUN apt-get update \
 && apt-get install --no-install-recommends --yes dbus-user-session gnome-keyring libsecret-tools libzstd1 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 yeokcham \
 && useradd --system --create-home --uid 10001 --gid 10001 --shell /bin/sh yeokcham \
 && install -d --owner 10001 --group 10001 --mode 0755 /workspace

COPY --from=build /home/opam/out/yeokcham /usr/local/bin/yeokcham
COPY --chmod=0755 containers/tutorial/entrypoint.sh /usr/local/bin/yeokcham-tutorial

ENV HOME=/home/yeokcham
WORKDIR /workspace
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/yeokcham-tutorial"]
CMD ["/bin/sh"]
