(executable
 (name yeokcham_v4)
 (public_name yeokcham)
 (modules yeokcham_v4 v4_watch v4_signer v4_signer_test_file)
 (flags
  (:standard -w -70))
 (libraries
  yeokcham_v4_local_service
  yeokcham_v4_bootstrap
  yeokcham_v4_inspection
  yeokcham_v4_model
  yeokcham_v4_package
  yeokcham_v4_recovery
  yeokcham_v4_transport
  yeokcham_v4_transport_config
  yeokcham_v4_transport_credential
  yeokcham_v4_transport_http
  yeokcham_v4_relay_http
  yeokcham_v4_relay_access
  yeokcham_v4_trust
  (select
   v4_watch.ml
   from
   (yeokcham_linux_watcher -> v4_watch_linux.ml)
   (-> v4_watch_unavailable.ml))
  (select
   v4_signer.ml
   from
   (yeokcham_v4_macos_keychain -> v4_signer_macos.ml)
   (yeokcham_v4_secret_service -> v4_signer_linux.ml)
   (-> v4_signer_unavailable.ml))))
