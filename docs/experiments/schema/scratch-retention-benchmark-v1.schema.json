{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/gongahkia/yeokcham/blob/main/docs/experiments/schema/scratch-retention-benchmark-v1.schema.json",
  "title":"Yeokcham scratch retention benchmark v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","benchmark_id","purpose","recorded_at_utc","fixture","execution","environment","policies","notes"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"scratch-retention-policies-v1"},
    "purpose":{"const":"host_specific_retention_policy_evidence_not_performance_claim"},
    "recorded_at_utc":{"type":"string","format":"date-time"},
    "fixture":{"$ref":"#/$defs/fixture"},
    "execution":{"$ref":"#/$defs/execution"},
    "environment":{"$ref":"#/$defs/environment"},
    "policies":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/policy_result"}},
    "notes":{"type":"string","minLength":1}
  },
  "$defs":{
    "count":{"type":"integer","minimum":0},
    "bytes":{"type":"integer","minimum":0},
    "fixture":{
      "type":"object",
      "additionalProperties":false,
      "required":["name","checkpoint_count","checksum"],
      "properties":{
        "name":{"const":"scratch-retention-linear-v1"},
        "checkpoint_count":{"const":25},
        "checksum":{
          "type":"object",
          "additionalProperties":false,
          "required":["algorithm","value"],
          "properties":{"algorithm":{"const":"sha256"},"value":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
        }
      }
    },
    "execution":{
      "type":"object",
      "additionalProperties":false,
      "required":["repetitions","warmup_runs","concurrency","cache_state"],
      "properties":{
        "repetitions":{"type":"integer","minimum":1},
        "warmup_runs":{"const":0},
        "concurrency":{"const":1},
        "cache_state":{"const":"mixed"}
      }
    },
    "environment":{
      "type":"object",
      "additionalProperties":false,
      "required":["os","word_size_bits","ocaml_version","dune_profile","filesystem_scope"],
      "properties":{
        "os":{"type":"string","minLength":1},
        "word_size_bits":{"type":"integer","minimum":1},
        "ocaml_version":{"type":"string","minLength":1},
        "dune_profile":{"type":"string","minLength":1},
        "filesystem_scope":{"const":"temporary local directory"}
      }
    },
    "policy_result":{
      "type":"object",
      "additionalProperties":false,
      "required":["name","policy","samples","restore_latency"],
      "properties":{
        "name":{"enum":["keep-all","recent-window","periodic","storage-budget"]},
        "policy":{
          "type":"object",
          "additionalProperties":false,
          "required":["recent_window_seconds","periodic_interval_seconds","storage_budget_bytes"],
          "properties":{
            "recent_window_seconds":{"$ref":"#/$defs/count"},
            "periodic_interval_seconds":{"$ref":"#/$defs/count"},
            "storage_budget_bytes":{"type":["integer","null"],"minimum":0}
          }
        },
        "samples":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sample"}},
        "restore_latency":{"$ref":"#/$defs/timing"}
      }
    },
    "sample":{
      "type":"object",
      "additionalProperties":false,
      "required":["restore_ns","active_object_store_bytes","retained_checkpoint_count","max_physical_event_depth","restored_pinned_target"],
      "properties":{
        "restore_ns":{"$ref":"#/$defs/count"},
        "active_object_store_bytes":{"$ref":"#/$defs/bytes"},
        "retained_checkpoint_count":{"type":"integer","minimum":2},
        "max_physical_event_depth":{"$ref":"#/$defs/count"},
        "restored_pinned_target":{"const":true}
      }
    },
    "timing":{
      "type":"object",
      "additionalProperties":false,
      "required":["samples_ns","min_ns","median_ns","max_ns"],
      "properties":{
        "samples_ns":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/count"}},
        "min_ns":{"$ref":"#/$defs/count"},
        "median_ns":{"$ref":"#/$defs/count"},
        "max_ns":{"$ref":"#/$defs/count"}
      }
    }
  }
}
