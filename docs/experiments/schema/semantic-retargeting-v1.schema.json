{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gongahkia/yeokcham/blob/main/docs/experiments/schema/semantic-retargeting-v1.schema.json",
  "title": "Yeokcham semantic retargeting v1 experiment",
  "description": "Versioned deterministic semantic-versus-textual retargeting result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "dataset_version",
    "timing_note",
    "results",
    "aggregates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "const": "semantic-retargeting-v1" },
    "dataset_version": { "const": 1 },
    "timing_note": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case_result" }
    },
    "aggregates": { "$ref": "#/$defs/aggregates" }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "start_byte", "end_byte" ],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 }
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "tool", "typescript", "node_minimum", "adapter_protocol" ],
      "properties": {
        "tool": { "const": "yeokcham-semantic-experiment-v1" },
        "typescript": { "const": "5.9.3" },
        "node_minimum": { "const": "14.17.0" },
        "adapter_protocol": { "const": 1 }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_id",
        "category",
        "strategy",
        "actual_outcome",
        "expected_outcome",
        "selected_file",
        "selected_span",
        "target_selection_correct",
        "exact_resulting_bytes_correct",
        "confidence",
        "match_stage",
        "parser_complete",
        "resolution_complete",
        "type_resolution_complete",
        "textual_fallback_used",
        "candidate_count",
        "safe_conflict",
        "false_confident",
        "false_negative",
        "false_application",
        "bytes_changed_outside_intended_span",
        "validation_result",
        "elapsed_ms",
        "tool_versions"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "fixture_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "strategy": { "enum": [ "semantic", "textual" ] },
        "actual_outcome": {
          "enum": [ "applied", "already-satisfied", "missing", "ambiguous", "rejected" ]
        },
        "expected_outcome": { "enum": [ "exact-bytes", "safe-conflict" ] },
        "selected_file": { "type": [ "string", "null" ] },
        "selected_span": {
          "anyOf": [ { "$ref": "#/$defs/span" }, { "type": "null" } ]
        },
        "target_selection_correct": { "type": "boolean" },
        "exact_resulting_bytes_correct": { "type": "boolean" },
        "confidence": {
          "enum": [ "exact", "high", "medium", "low", "unknown", "not-semantic" ]
        },
        "match_stage": { "type": [ "string", "null" ] },
        "parser_complete": { "type": [ "boolean", "null" ] },
        "resolution_complete": { "type": [ "boolean", "null" ] },
        "type_resolution_complete": { "type": [ "boolean", "null" ] },
        "textual_fallback_used": { "type": "boolean" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "safe_conflict": { "type": "boolean" },
        "false_confident": { "type": "boolean" },
        "false_negative": { "type": "boolean" },
        "false_application": { "type": "boolean" },
        "bytes_changed_outside_intended_span": { "type": "boolean" },
        "validation_result": { "type": "string", "minLength": 1 },
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "tool_versions": { "$ref": "#/$defs/tool_versions" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases",
        "exact_correct_applications",
        "nonexact_correct_applications",
        "safe_conflicts",
        "false_confident_applications",
        "false_negatives",
        "false_applications",
        "already_satisfied",
        "confidence_distribution",
        "parser_complete_cases",
        "resolution_complete_cases",
        "type_resolution_complete_cases",
        "textual_fallback_uses"
      ],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "exact_correct_applications": { "type": "integer", "minimum": 0 },
        "nonexact_correct_applications": { "type": "integer", "minimum": 0 },
        "safe_conflicts": { "type": "integer", "minimum": 0 },
        "false_confident_applications": { "type": "integer", "minimum": 0 },
        "false_negatives": { "type": "integer", "minimum": 0 },
        "false_applications": { "type": "integer", "minimum": 0 },
        "already_satisfied": { "type": "integer", "minimum": 0 },
        "confidence_distribution": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "parser_complete_cases": { "type": "integer", "minimum": 0 },
        "resolution_complete_cases": { "type": "integer", "minimum": 0 },
        "type_resolution_complete_cases": { "type": "integer", "minimum": 0 },
        "textual_fallback_uses": { "type": "integer", "minimum": 0 }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "semantic", "textual", "by_category", "semantic_vs_textual" ],
      "properties": {
        "semantic": { "$ref": "#/$defs/aggregate" },
        "textual": { "$ref": "#/$defs/aggregate" },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "semantic", "textual" ],
            "properties": {
              "semantic": { "$ref": "#/$defs/aggregate" },
              "textual": { "$ref": "#/$defs/aggregate" }
            }
          }
        },
        "semantic_vs_textual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "both_correct",
            "semantic_only_correct",
            "textual_only_correct",
            "neither_correct",
            "textual_outperforms_fixture_ids"
          ],
          "properties": {
            "both_correct": { "type": "integer", "minimum": 0 },
            "semantic_only_correct": { "type": "integer", "minimum": 0 },
            "textual_only_correct": { "type": "integer", "minimum": 0 },
            "neither_correct": { "type": "integer", "minimum": 0 },
            "textual_outperforms_fixture_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
