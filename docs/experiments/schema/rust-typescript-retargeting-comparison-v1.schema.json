{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gongahkia/yeokcham/blob/main/docs/experiments/schema/rust-typescript-retargeting-comparison-v1.schema.json",
  "title": "Yeokcham Rust TypeScript retargeting comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "timing_note", "comparison_boundary", "typescript_baseline", "rust_workload", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "rust-typescript-retargeting-comparison-v1"},
    "timing_note": {"type": "string", "minLength": 1},
    "comparison_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloads_are_separate", "cross_language_generalisation", "rust_semantic_retargeting"],
      "properties": {
        "workloads_are_separate": {"const": true},
        "cross_language_generalisation": {"const": "not-supported"},
        "rust_semantic_retargeting": {"const": "not-implemented"}
      }
    },
    "typescript_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_report", "dataset_version", "fixture_count", "semantic", "textual"],
      "properties": {
        "source_report": {"const": "semantic-retargeting-v1"},
        "dataset_version": {"const": 1},
        "fixture_count": {"const": 40},
        "semantic": {"$ref": "#/$defs/typescript_strategy"},
        "textual": {"$ref": "#/$defs/typescript_strategy"}
      }
    },
    "rust_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "fixtures", "aggregate"],
      "properties": {
        "dataset_version": {"const": 1},
        "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rust_fixture"}},
        "aggregate": {"$ref": "#/$defs/rust_aggregate"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "typescript_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["false_confident_applications", "false_negatives", "false_applications"],
      "properties": {
        "false_confident_applications": {"type": "integer", "minimum": 0},
        "false_negatives": {"type": "integer", "minimum": 0},
        "false_applications": {"type": "integer", "minimum": 0}
      }
    },
    "rust_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "category", "expected_outcome", "actual_outcome", "exact_resulting_bytes_correct", "safe_conflict", "false_application", "false_negative", "parser_complete", "textual_fallback_required"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "expected_outcome": {"enum": ["exact-textual-bytes", "safe-conflict"]},
        "actual_outcome": {"enum": ["applied", "safe-conflict", "rejected"]},
        "exact_resulting_bytes_correct": {"type": "boolean"},
        "safe_conflict": {"type": "boolean"},
        "false_application": {"type": "boolean"},
        "false_negative": {"type": "boolean"},
        "parser_complete": {"type": "boolean"},
        "textual_fallback_required": {"type": "boolean"}
      }
    },
    "rust_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cases", "exact_textual_applications", "safe_conflicts", "false_confident_semantic_applications", "false_negatives", "false_applications", "semantic_attempts", "parser_complete_cases", "textual_fallback_required_cases"],
      "properties": {
        "total_cases": {"type": "integer", "minimum": 0},
        "exact_textual_applications": {"type": "integer", "minimum": 0},
        "safe_conflicts": {"type": "integer", "minimum": 0},
        "false_confident_semantic_applications": {"const": 0},
        "false_negatives": {"type": "integer", "minimum": 0},
        "false_applications": {"type": "integer", "minimum": 0},
        "semantic_attempts": {"const": 0},
        "parser_complete_cases": {"type": "integer", "minimum": 0},
        "textual_fallback_required_cases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
