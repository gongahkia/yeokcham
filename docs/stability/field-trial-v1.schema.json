{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongahkia.github.io/yeokcham/schemas/field-trial-v1.schema.json",
  "title": "Yeokcham 1.0 field-trial evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "platform",
    "release-version",
    "commit",
    "host",
    "toolchain",
    "commands",
    "checks",
    "result"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "platform": {
      "enum": ["linux", "macos", "wsl"]
    },
    "release-version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os-version", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "os-version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocaml", "opam", "dune"],
      "properties": {
        "ocaml": { "type": "string", "minLength": 1 },
        "opam": { "type": "string", "minLength": 1 },
        "dune": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make-check", "full-backup-restore", "peer-ssh"],
      "properties": {
        "make-check": { "const": true },
        "full-backup-restore": { "const": true },
        "peer-ssh": { "const": true }
      }
    },
    "result": {
      "const": "pass"
    },
    "notes": {
      "type": "string"
    }
  }
}
