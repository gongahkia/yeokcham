# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Experimental model-first local-first version control"
description:
  "A local-first VCS separating scratch, intent, and release history."
maintainer: ["Gabriel Ong Zhe Mian <angryapplegravy@gmail.com>"]
authors: ["Gabriel Ong Zhe Mian"]
license: "MIT"
homepage: "https://github.com/gongahkia/paengi"
bug-reports: "https://github.com/gongahkia/paengi/issues"
depends: [
  "ocaml" {= "5.5.0"}
  "dune" {>= "3.23"}
  "digestif" {= "1.3.1"}
  "mirage-crypto-ec" {= "2.2.0"}
  "mirage-crypto-rng" {= "2.2.0"}
  "alcotest" {= "1.9.1" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "qcheck-alcotest" {= "0.91" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/gongahkia/paengi.git"
x-maintenance-intent: ["(latest)"]
