# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Experimental model-first local-first version control"
description:
  "A local-first VCS separating scratch, intent, and release history."
depends: [
  "ocaml" {= "5.5.0"}
  "dune" {>= "3.23"}
  "alcotest" {= "1.9.1" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "qcheck-alcotest" {= "0.91" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
