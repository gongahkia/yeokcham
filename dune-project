(lang dune 3.23)
(name paengi)
(generate_opam_files true)
(source (github gongahkia/paengi))
(authors "Gabriel Ong Zhe Mian")
(maintainers "Gabriel Ong Zhe Mian <angryapplegravy@gmail.com>")
(license MIT)

(package
 (name paengi)
 (synopsis "Experimental model-first local-first version control")
 (description "A local-first VCS separating scratch, intent, and release history.")
 (allow_empty)
 (depends
  (ocaml (= 5.5.0))
  (dune (>= 3.23))
  (digestif (= 1.3.1))
  (mirage-crypto (= 2.2.0))
  (mirage-crypto-ec (= 2.2.0))
  (mirage-crypto-rng (= 2.2.0))
  (alcotest (and (= 1.9.1) :with-test))
  (qcheck-core (and (= 0.91) :with-test))
  (qcheck-alcotest (and (= 0.91) :with-test))))
