(rule
 (alias property-test)
 (deps
  (:encoding_property_test encoding_property_test.exe)
  (:model_property_test model_property_test.exe)
  (:store_property_test store_property_test.exe)
  (:exchange_property_test exchange_property_test.exe)
  (:ref_event_property_test ref_event_property_test.exe)
  (:device_property_test device_property_test.exe)
  (:http_exchange_property_test http_exchange_property_test.exe)
  (:snapshot_property_test snapshot_property_test.exe)
  (:scratch_property_test scratch_property_test.exe)
  (:compaction_property_test compaction_property_test.exe)
  (:capsule_property_test capsule_property_test.exe)
  (:capsule_durable_property_test capsule_durable_property_test.exe)
  (:workspace_property_test workspace_property_test.exe)
  (:release_validation_property_test release_validation_property_test.exe)
  (:semantic_property_test semantic_property_test.exe)
  (:semantic_retarget_property_test semantic_retarget_property_test.exe)
  (:rust_adapter_property_test rust_adapter_property_test.exe)
  (:rust_retarget_fixture_property_test
   rust_retarget_fixture_property_test.exe)
  (:git_property_test git_property_test.exe)
  (source_tree fixtures/encoding))
 (action
  (progn
   (run %{encoding_property_test})
   (run %{model_property_test})
   (run %{store_property_test})
   (run %{exchange_property_test})
   (run %{ref_event_property_test})
   (run %{device_property_test})
   (run %{http_exchange_property_test})
   (run %{snapshot_property_test})
   (run %{scratch_property_test})
   (run %{compaction_property_test})
   (run %{capsule_property_test})
   (run %{capsule_durable_property_test})
   (run %{workspace_property_test})
   (run %{release_validation_property_test})
   (run %{semantic_property_test})
   (run %{semantic_retarget_property_test})
   (run %{rust_adapter_property_test})
   (run %{rust_retarget_fixture_property_test})
   (run %{git_property_test}))))
